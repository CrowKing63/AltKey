<!-- 플라스틱 카테고리(기본) — 다크 변종. 마감: 탄소섬유 (중립 스텔스, 순수 중립 회색).
     "카본도 결국 합성 소재이므로 플라스틱 계열"이라는 결정에 따라 기본 슬롯으로 사용 (테스트용, v4).
     테마 사전(DarkTheme.xaml) 뒤에 MergedDictionaries에 추가되어 같은 키만 이깁니다. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 키보드 컨테이너: 탄소섬유 자연색 — 중립 블랙(1E1E1E)에 아주 미세하게 밝음, 블루 시프트 없음 -->
    <SolidColorBrush x:Key="KeyboardBg"   Color="#CC262628"/>
    <!-- 키캡 배경: 중립 회색 — 하우징과 명확한 명도 차이 -->
    <SolidColorBrush x:Key="KeyBg"        Color="#CC3A3A3C"/>
    <SolidColorBrush x:Key="KeyBgHover"   Color="#CC4E4E50"/>
    <SolidColorBrush x:Key="KeyBgPressed" Color="#FF313133"/>
    <!-- 키 테두리: hairline — v11: 라이트와 α 배율 일치(베이스 0.67×). 합성 ΔL* 13.8→3.6 -->
    <SolidColorBrush x:Key="KeyBorder"    Color="#0AFFFFFF"/>
    <!-- 상단 바 hover/pressed (패널도 공유) — 중립 스텔스 톤 -->
    <SolidColorBrush x:Key="HeaderBarHoverBg"   Color="#CC5F5F61"/>
    <SolidColorBrush x:Key="HeaderBarPressedBg" Color="#CC717173"/>
    <!-- 액센트 키(사용자 지정 특수 키) — 같은 중립 탄소 계열로 재질 통일 -->
    <SolidColorBrush x:Key="KeyBgAccent"        Color="#CC4B4B4D"/>
    <SolidColorBrush x:Key="KeyBgAccentHover"   Color="#CC575759"/>
    <SolidColorBrush x:Key="KeyBgAccentPressed" Color="#CC444446"/>
    <!-- 액센트 키 글자: 중립 오프화이트 -->
    <SolidColorBrush x:Key="KeyFgAccent"        Color="#FFF2F2F4"/>
    <!-- 액센트 키 테두리: 크리스프 중립 (강화) -->
    <SolidColorBrush x:Key="KeyBorderAccent"    Color="#8A909094"/>
</ResourceDictionary>
