<!-- 메탈 재질(다크) — 소재: 티타늄 (건메틸, grade 5 무디한 프리미엄 그레이).
     공간 그레이(블루 시프트)나 탄소(순수 중립 블랙)가 아니라,
     올리브/브라운 힌트의 "무뎌진" 다크 메탈로 알루미늄 라이트와 같은 금속계열의 다크 변주를 줍니다.
     테마 사전(DarkTheme.xaml) 뒤에 MergedDictionaries에 추가되어 같은 키만 이깁니다. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 키보드 컨테이너: 티타늄 건메탈 — 중립 블랙(1E1E1E)보다 밝고, 스페이스 그레이(2F3540)보다 따뜻하고 무뎬 -->
    <SolidColorBrush x:Key="KeyboardBg"   Color="#CC32342F"/>
    <!-- 키캡 배경: 무디한 다크 그레이, 하우징과 명확한 명도 차이 -->
    <SolidColorBrush x:Key="KeyBg"        Color="#CC464842"/>
    <SolidColorBrush x:Key="KeyBgHover"   Color="#CC5B5D55"/>
    <SolidColorBrush x:Key="KeyBgPressed" Color="#FF3C3E38"/>
    <!-- 키 테두리: 가공 모서리 — v11: 라이트와 α 배율 일치(베이스 2.13×). 합성 ΔL* 12.3→9.8 -->
    <SolidColorBrush x:Key="KeyBorder"    Color="#20FFFFFF"/>
    <!-- 상단 바 hover/pressed (패널도 공유) — 무디한 티타늄 톤 -->
    <SolidColorBrush x:Key="HeaderBarHoverBg"   Color="#CC6C6E64"/>
    <SolidColorBrush x:Key="HeaderBarPressedBg" Color="#CC7E8074"/>
    <!-- 액센트 키(사용자 지정 특수 키) — 같은 무디한 티타늄 계열로 재질 통일 -->
    <SolidColorBrush x:Key="KeyBgAccent"        Color="#CC575953"/>
    <SolidColorBrush x:Key="KeyBgAccentHover"   Color="#CC64665E"/>
    <SolidColorBrush x:Key="KeyBgAccentPressed" Color="#CC4F514B"/>
    <!-- 액센트 키 글자: 따뜻한 오프화이트 -->
    <SolidColorBrush x:Key="KeyFgAccent"        Color="#FFF2F3EF"/>
    <!-- 액센트 키 테두리: 일반 키 테두리와 명확히 구분되는 밝은 웜그레이 -->
    <SolidColorBrush x:Key="KeyBorderAccent"    Color="#A0A0A398"/>
</ResourceDictionary>
