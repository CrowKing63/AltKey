<!-- 우드 재질(다크) — 소재: 월넛 (가장 범용성 높은 미디엄 브라운).
     다크 오크(에스프레소, 3B2D20)보다 확실히 밝고 붉은색 포화가 있는 "월넛 가구" 톤.
     테마 사전(DarkTheme.xaml) 뒤에 MergedDictionaries에 추가되어 같은 키만 이깁니다. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 키보드 컨테이너: 딥 월넛 — 중립 블랙(1E1E1E)보다 따뜻, 다크 오크(3B2D20)보다 밝고 붉음 -->
    <SolidColorBrush x:Key="KeyboardBg"   Color="#CC4C3A28"/>
    <!-- 키캡 배경: 미디엄 월넛 — 하우징과 명확한 명도 차이 -->
    <SolidColorBrush x:Key="KeyBg"        Color="#CC615038"/>
    <SolidColorBrush x:Key="KeyBgHover"   Color="#CC75624A"/>
    <SolidColorBrush x:Key="KeyBgPressed" Color="#FF54432E"/>
    <!-- 키 테두리: 월넛 골드 — α 12% (v11 수치 확인: 베이스 대비 약 2.1배 강화, "약화"가 아님) -->
    <SolidColorBrush x:Key="KeyBorder"    Color="#1FFFE8C8"/>
    <!-- 상단 바 hover/pressed (패널도 공유) — 월넛 톤 -->
    <SolidColorBrush x:Key="HeaderBarHoverBg"   Color="#CC7A6750"/>
    <SolidColorBrush x:Key="HeaderBarPressedBg" Color="#CC8B7960"/>
    <!-- 액센트 키(사용자 지정 특수 키) — 같은 월넛 계열로 재질 통일 -->
    <SolidColorBrush x:Key="KeyBgAccent"        Color="#CC726149"/>
    <SolidColorBrush x:Key="KeyBgAccentHover"   Color="#CC7E6B53"/>
    <SolidColorBrush x:Key="KeyBgAccentPressed" Color="#CC675641"/>
    <!-- 액센트 키 글자: 크림 화이트 -->
    <SolidColorBrush x:Key="KeyFgAccent"        Color="#FFF5EFE4"/>
    <!-- 액센트 키 테두리: 월넛 골드 하이라이트 (강화) -->
    <SolidColorBrush x:Key="KeyBorderAccent"    Color="#8A9E8258"/>
</ResourceDictionary>
