<!-- 메탈 재질(라이트) 오버라이드 — 컨셉: 알루미늄 하우징 (anodized silver).
     플라스틱의 중립 밝은 회색과 구분되도록 하우징을 더 진하고 차가운 실버로,
     키 테두리는 가공된 모서리처럼 또렷하게 강화합니다.
     테마 사전(LightTheme.xaml) 뒤에 MergedDictionaries에 추가되어 같은 키만 이깁니다. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 키보드 컨테이너: 실버 그라데이션의 중간 톤 — 플라스틱(E8E8EC)보다 진하고 차가움 -->
    <SolidColorBrush x:Key="KeyboardBg"   Color="#CCCBD1DA"/>
    <!-- 키캡 배경: 차가운 거의-흰색 (알루미늄 키캡 느낌) -->
    <SolidColorBrush x:Key="KeyBg"        Color="#FFF8FAFC"/>
    <SolidColorBrush x:Key="KeyBgHover"   Color="#FFC7CFDB"/>
    <SolidColorBrush x:Key="KeyBgPressed" Color="#FFAEB9C8"/>
    <!-- 키 테두리: 가공 모서리처럼 강화 (플라스틱 #1E000000의 2배) -->
    <SolidColorBrush x:Key="KeyBorder"    Color="#40000000"/>
    <!-- 상단 바 hover/pressed (패널도 공유) — 차가운 실버 톤 -->
    <SolidColorBrush x:Key="HeaderBarHoverBg"   Color="#FFD5DCE6"/>
    <SolidColorBrush x:Key="HeaderBarPressedBg" Color="#FFBFC9D7"/>
    <!-- 액센트 키(사용자 지정 특수 키) — 같은 차가운 실버 계열로 재질 통일.
         정지 채우기가 일반키와 너무 가까워 구분하기 약했으므로(ΔL 0.058), 원본 테마 수준(ΔL≈0.097)으로
         진하게 조정했습니다. hover/pressed 단계는 기존 그대로 유지합니다. -->
    <SolidColorBrush x:Key="KeyBgAccent"        Color="#FFEDEEF3"/>
    <SolidColorBrush x:Key="KeyBgAccentHover"   Color="#FFD7DFEA"/>
    <SolidColorBrush x:Key="KeyBgAccentPressed" Color="#FFC4CDDC"/>
    <!-- 액센트 키 글자: 차가운 거의-검정 -->
    <SolidColorBrush x:Key="KeyFgAccent"        Color="#FF1E242E"/>
    <!-- 액센트 키 테두리: 일반 키 테두리(25% 블랙 강화)와 명확히 구분되는 차가운 스틸그레이 -->
    <SolidColorBrush x:Key="KeyBorderAccent"    Color="#8A525E6E"/>
</ResourceDictionary>
