<!-- 플라스틱 카테고리(기본) — 라이트 변종. 마감: 유리/세라믹 (frost 화이트 + hairline 테두리).
     "유리·세라믹도 결국 합성 소재이므로 플라스틱 계열"이라는 결정에 따라 기본 슬롯으로 사용 (테스트용, v4).
     테마 사전(LightTheme.xaml) 뒤에 MergedDictionaries에 추가되어 같은 키만 이깁니다. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 키보드 컨테이너: frost 화이트 — 플라스틱 기본(E8E8EC)보다 더 밝고 차가움, 광택감 -->
    <SolidColorBrush x:Key="KeyboardBg"   Color="#CCEFF1F4"/>
    <!-- 키캡 배경: 순수 흰색 (유리 표면) -->
    <SolidColorBrush x:Key="KeyBg"        Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="KeyBgHover"   Color="#FFE8EBEF"/>
    <SolidColorBrush x:Key="KeyBgPressed" Color="#FFD9DEE4"/>
    <!-- 키 테두리: hairline — 모든 재질 중 가장 약한 유지, 다만 6%→8%로 올려 정지 시에도 경계선 식별 가능 (v10) -->
    <SolidColorBrush x:Key="KeyBorder"    Color="#14000000"/>
    <!-- 상단 바 hover/pressed (패널도 공유) — frost 톤 -->
    <SolidColorBrush x:Key="HeaderBarHoverBg"   Color="#FFECEFF3"/>
    <SolidColorBrush x:Key="HeaderBarPressedBg" Color="#FFDFE3E8"/>
    <!-- 액센트 키(사용자 지정 특수 키) — frost 화이트 계열 (기본값과 거의 같아 재질감이 약함 = 유리 특성) -->
    <SolidColorBrush x:Key="KeyBgAccent"        Color="#FFF5F7FA"/>
    <SolidColorBrush x:Key="KeyBgAccentHover"   Color="#FFE9EDF2"/>
    <SolidColorBrush x:Key="KeyBgAccentPressed" Color="#FFDCE2E9"/>
    <!-- 액센트 키 글자: 차가운 거의-검정 -->
    <SolidColorBrush x:Key="KeyFgAccent"        Color="#FF1C2028"/>
    <!-- 액센트 키 테두리: hairline 유지 (약화) -->
    <SolidColorBrush x:Key="KeyBorderAccent"    Color="#3A707884"/>
</ResourceDictionary>
