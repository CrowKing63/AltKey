<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyVersion>1.7.4.0</AssemblyVersion>
    <FileVersion>1.7.4.0</FileVersion>
    <Version>1.7.4</Version>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
  </PropertyGroup>
  <!-- Windows Sandbox 테스트 빌드: publish 시 -p:SandboxTestBuild=true 를 붙이면 SANDBOX_TEST 상수가 정의되고
       관리자 권한 체크가 비활성화되어 샌드박스(모든 프로세스가 관리자 권한)에서도 자동완성(Unicode 모드)을
       테스트할 수 있다. 정식 빌드(인자 없음)에는 영향이 없다. -->
  <PropertyGroup Condition="'$(SandboxTestBuild)' == 'true'">
    <DefineConstants>$(DefineConstants);SANDBOX_TEST</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.*" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.*" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.*" />
    <PackageReference Include="WPF-UI" Version="3.*" />
    <PackageReference Include="System.Speech" Version="8.*" />
  </ItemGroup>

  <!-- 테스트 프로젝트가 SoundService의 internal 헬퍼(ResolvePath 등)를 검증할 수 있도록 열려 줍니다. -->
  <ItemGroup>
    <InternalsVisibleTo Include="AltKey.Tests" />
  </ItemGroup>
  
  <ItemGroup>
    <!-- config.json은 출력 폴더로 복사하지 않는다.
         exe 옆에 config.json이 있으면 포터블 모드로 오인하는데,
         MSIX(스토어) 패키지에 포함되면 읽기 전용 설치 디렉터리에 쓰려 시작이 실패한다.
         포트레블 ZIP용 config.json은 scripts/package-portable.ps1이 직접 생성한다. -->
    <Content Include="layouts\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  
  <ItemGroup>
    <Content Include="Assets\icon.ico" Condition="Exists('Assets\icon.ico')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\tray-icon.ico" Condition="Exists('Assets\tray-icon.ico')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\emoji.json" Condition="Exists('Assets\emoji.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    
    <!-- 키 효과음 프리셋: 1=또렷(기본), 2=균형, 3=빠른 스냅, 4=타자기, 5=타자기(깊은 타건), 6=옛날 레트로, 7=맥 레트로. 설정에서 번호로 고른다. -->
    <Content Include="Assets\Sounds\1.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Sounds\2.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Sounds\3.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Sounds\4.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Sounds\5.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Sounds\6.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Sounds\7.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <!-- 설정 창 헤더 로고: 어두운 잉크 배경이라 라이트/다크 테마 모두에서 대비가 유지된다. -->
    <Resource Include="Assets\logo.png" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\Data\ko-words.txt" />
    <EmbeddedResource Include="Assets\Data\en-words.txt" />
  </ItemGroup>
</Project>
