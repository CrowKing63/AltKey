<local:AnchoredPanelWindowBase x:Class="AltKey.Views.ScratchPadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AltKey.Views"
        mc:Ignorable="d"
        Title="빠른 메모"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="600" Height="320"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave">

    <local:AnchoredPanelWindowBase.Resources>
        <!-- 접근성/시각 일관성: 키보드 상단바 버튼과 같은 호버 대비를 써서
             패드 안에서도 "누를 수 있는 곳"이 예측되게 합니다. -->
        <Style x:Key="PadButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SettingsFg}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="7,2">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder"
                                        Property="Background"
                                        Value="{DynamicResource HeaderBarHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RootBorder"
                                        Property="Background"
                                        Value="{DynamicResource HeaderBarPressedBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 가/A 버튼: 테마 강조색을 유지하면서 호버·누름 반응은 opacity로 준다.
             PadButtonStyle의 배경 색trigger는 로컬 배경값에 가려지므로 이 방식으로 피드백을 보존한다. -->
        <Style x:Key="AccentPadButtonStyle" TargetType="Button" BasedOn="{StaticResource PadButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.7"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </local:AnchoredPanelWindowBase.Resources>

    <!-- 접근성/미관: 메인 키보드 창과 같은 둥근 카드로 그려 바깥 직각 레이어를 숨긴다. -->
    <Border Background="{DynamicResource KeyboardBg}"
            CornerRadius="{StaticResource KeyboardRadius}"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 상단 헤더 바: 드래그 핸들 + 편집 숏컷 버튼 + 닫기 -->
            <Grid Grid.Row="0" Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 드래그 핸들: 키보드 창과 같은 패턴(누르면 이동, 더블 클릭은 수평 중앙) -->
                <Border x:Name="DragHandle"
                        Grid.Column="0"
                        Background="Transparent"
                        Cursor="SizeAll"
                        Margin="2,0" Padding="6,12"
                        MouseLeftButtonDown="DragHandle_MouseLeftButtonDown"
                        MouseMove="DragHandle_MouseMove"
                        MouseLeftButtonUp="DragHandle_MouseLeftButtonUp"
                        LostMouseCapture="DragHandle_LostMouseCapture">
                    <Rectangle Width="36" Height="4"
                               Fill="{DynamicResource SettingsFg}"
                               Opacity="0.45"
                               RadiusX="2" RadiusY="2"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"/>
                </Border>

                <!-- 편집 숏컷 버튼 (D7: 앱 간 자동화 없음 — TextBox 안에서만 동작) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource PadButtonStyle}"
                            FontSize="{DynamicResource ScaledSettingsBaseFontSize}"
                            Click="SelectAllButton_Click"
                            ToolTip="모두 선택 (Ctrl+A)"
                            AutomationProperties.Name="모두 선택">
                        <TextBlock Text="모두 선택"/>
                    </Button>
                    <Button Style="{StaticResource PadButtonStyle}"
                            FontSize="{DynamicResource ScaledSettingsBaseFontSize}"
                            Click="ClearButton_Click"
                            ToolTip="지우기"
                            AutomationProperties.Name="지우기">
                        <TextBlock Text="지우기"/>
                    </Button>
                    <Button Style="{StaticResource PadButtonStyle}"
                            FontSize="{DynamicResource ScaledSettingsBaseFontSize}"
                            Click="CutButton_Click"
                            ToolTip="잘라내기 (Ctrl+X)"
                            AutomationProperties.Name="잘라내기">
                        <TextBlock Text="자르기"/>
                    </Button>
                    <Button Style="{StaticResource PadButtonStyle}"
                            FontSize="{DynamicResource ScaledSettingsBaseFontSize}"
                            Click="CopyButton_Click"
                            ToolTip="복사 (Ctrl+C)"
                            AutomationProperties.Name="복사">
                        <TextBlock Text="복사"/>
                    </Button>
                    <Button Style="{StaticResource PadButtonStyle}"
                            FontSize="{DynamicResource ScaledSettingsBaseFontSize}"
                            Click="PasteButton_Click"
                            ToolTip="붙여넣기 (Ctrl+V)"
                            AutomationProperties.Name="붙여넣기">
                        <TextBlock Text="붙여넣기"/>
                    </Button>
                    <!-- 가/A: 메인 키보드 토글과 같은 서브모드 — 붙여넣기 오른쪽, 닫기 왼쪽.
                         강조색은 메인 키보드 가/A 키와 같은 AccentBrush를 써서 테마 간 일관성을 유지합니다.
                         '가'와 'A'의 글자 폭이 달라 왼쪽 버튼들이 흔들리지 않도록 너비는 고정합니다. -->
                    <Button x:Name="KoreanSubmodeButton"
                            Style="{StaticResource AccentPadButtonStyle}"
                            Width="32"
                            Background="{DynamicResource AccentBrush}"
                            Foreground="{DynamicResource AccentForegroundBrush}"
                            FontSize="{DynamicResource ScaledSettingsBaseFontSize}"
                            Click="KoreanSubmodeButton_Click"
                            ToolTip="영어 입력으로 전환"
                            AutomationProperties.Name="영어로 전환">
                        <TextBlock x:Name="KoreanSubmodeLabel" Text="가"/>
                    </Button>
                </StackPanel>

                <!-- 닫기: 숨김(종료 아님) — MainViewModel이 Show/Hide를 관리 -->
                <Button x:Name="CloseButton"
                        Grid.Column="3"
                        Style="{StaticResource PadButtonStyle}"
                        Width="26" Height="24" Margin="4,0,0,0"
                        Click="CloseButton_Click"
                        ToolTip="빠른 메모 닫기"
                        AutomationProperties.Name="빠른 메모 닫기">
                    <TextBlock Text="&#x2715;" FontSize="{DynamicResource ScaledSettingsBaseFontSize}"/>
                </Button>
            </Grid>

            <!-- 메모 영역: 멀티라인 + 자동 줄바꿈, 큰 글자 배율.
                 선택 색은 테마별 MemoSelection* 브러시(라벤더 계열) — 기본 SettingsHighlight는 거의 안 보여서 교체 (2026-11-15). -->
            <TextBox x:Name="NoteTextBox"
                     Grid.Row="1"
                     Margin="12,6,12,12"
                     BorderThickness="0"
                     Background="Transparent"
                     Foreground="{DynamicResource SettingsFg}"
                     CaretBrush="{DynamicResource SettingsFg}"
                     SelectionBrush="{DynamicResource MemoSelectionBg}"
                     FontSize="{DynamicResource ScaledSettingsBodyLargeFontSize}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top"
                     Text="{Binding Text, Mode=TwoWay}"/>
        </Grid>
    </Border>
</local:AnchoredPanelWindowBase>
