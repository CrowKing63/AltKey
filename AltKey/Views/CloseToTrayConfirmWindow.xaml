<Window x:Class="AltKey.Views.CloseToTrayConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="AltKey 숨김 확인"
        Width="430"
        Height="360"
        MinWidth="400"
        MinHeight="340"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource SettingsBg}">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource FluentButtonStyle}"/>
    </Window.Resources>

    <Border Background="{DynamicResource SettingsBg}"
            CornerRadius="12"
            Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="키보드 창을 트레이로 숨길까요?"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SettingsFg}"
                           Margin="0,0,0,8"/>
                <TextBlock Text="전체 창 모드 앱을 사용 중일 때는 창이 화면에서 사라지면 다시 불러오기가 어려울 수 있습니다."
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="{DynamicResource SettingsFgSub}"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1"
                          Margin="0,16,0,16"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="True">
                <StackPanel>
                    <TextBlock Text="다시 보이는 방법"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SettingsFg}"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="• 트레이 아이콘 더블 클릭"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="{DynamicResource SettingsFgSub}"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="• 트레이 메뉴의 보이기/숨기기"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="{DynamicResource SettingsFgSub}"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="• 전역 단축키"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="{DynamicResource SettingsFgSub}"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="• AltKey를 다시 실행하면 기존 창 복원"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="{DynamicResource SettingsFgSub}"
                               Margin="0,0,0,12"/>

                    <CheckBox x:Name="DontAskAgainCheckBox"
                              Content="앞으로 다시 묻지 않기"
                              Foreground="{DynamicResource SettingsFg}"
                              AutomationProperties.Name="앞으로 다시 묻지 않기"/>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="CancelButtonElement"
                        Grid.Column="1"
                        Content="취소"
                        Width="110"
                        Height="36"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        IsDefault="True"
                        Click="CancelButton_Click"
                        AutomationProperties.Name="트레이 숨김 취소"/>
                <Button Grid.Column="2"
                        Content="트레이로 숨기기"
                        Width="130"
                        Height="36"
                        Click="HideToTrayButton_Click"
                        Background="{DynamicResource SettingsHighlight}"
                        Foreground="{DynamicResource SettingsFg}"
                        AutomationProperties.Name="트레이로 숨기기"/>
            </Grid>
        </Grid>
    </Border>
</Window>
