<local:AnchoredPanelWindowBase x:Class="AltKey.Views.ClipboardPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AltKey.Views"
        xmlns:themes="clr-namespace:AltKey.Themes"
        mc:Ignorable="d"
        Title="클립보드"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="360" Height="420">

    <local:AnchoredPanelWindowBase.Resources>
        <!-- 빈 문자열 → Visible (검색 placeholder용) -->
        <local:StringEmptyToVisibilityConverter x:Key="StringEmptyToVis"/>
        <!-- bool/문자열 → Visibility 계열 (테마 공용 컨버터 재사용) -->
        <themes:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <themes:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
        <themes:NullToCollapsedConverter x:Key="NonEmptyToVis"/>

        <!-- [D3] 행 액션 버튼: 호버 없이 항상 보임(터치 탭만 사용), 호버는 색 피드백만. 타깃 ≥32px -->
        <Style x:Key="RowActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SettingsFgSub}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource HeaderBarHoverBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource SettingsFg}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource HeaderBarPressedBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 헤더 버튼(전체 삭제·✕): 키보드 상단바와 같은 호버 대비 -->
        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SettingsFgSub}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="8,3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource HeaderBarHoverBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource SettingsFg}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource HeaderBarPressedBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 항목 행: 전체면 = 붙여넣기 버튼, 우측 ★·✕는 그 위에 얹힌 별도 버튼 (클릭은 각자 처리) -->
        <DataTemplate x:Key="ClipboardItemRow">
            <!-- [2줄 미리보기] 행 높이는 44px 고정 — 긴 미리보기는 최대 2줄까지 줄바꿈되고 그 이상은 ellipsis -->
            <Grid Height="44" Margin="0,1">
                <!-- 붙여넣기 영역: 미리보기(최대 2줄 줄바꿈) + 상대 시간. 우측 70px는 ★·✕ 버튼 자리.
                     행 클릭/Enter = 이 버튼의 커맨드 (DataContext = ClipboardItem) -->
                <Button Focusable="False"
                        Command="{Binding DataContext.PasteItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding FullText}"
                        Cursor="Hand" Background="Transparent" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="RowBorder" Background="Transparent" CornerRadius="8" Padding="10,0,70,0">
                                <!-- 미리보기는 남은 폭(시간 열 제외) 안에서 줄바꿈하고 최대 2줄까지 표시.
                                     MaxHeight 35 = 라인 높이 17.29px × 2줄 ≈ 34.58 — 그 이상은 ellipsis.
                                     세로 중앙 정렬로 고정 높이(44px) 행 안에서 균형을 맞춘다 (측정 확인). -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Preview}" FontSize="13"
                                               Foreground="{DynamicResource SettingsFg}"
                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="35"
                                               VerticalAlignment="Center"/>
                                    <!-- 상대 시간: 기록 없으면(구형 데이터) 빈 문자열이라 안 보임 -->
                                    <TextBlock Grid.Column="1" Text="{Binding TimeText}" FontSize="11"
                                               Foreground="{DynamicResource SettingsFgHint}"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource HeaderBarHoverBg}"/>
                                </Trigger>
                                <!-- [D5] 키보드 내비게이션 선택: 라벤더 틴 배경 -->
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="RowBorder" Property="Background" Value="#26C4B5FD"/>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- ★ 고정 토글: 항상 보임(호버 불필요). 라벤더 = 브랜드 액센트. ☆=미고정, ★=고정 -->
                <Button Style="{StaticResource RowActionButtonStyle}"
                        Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding FullText}"
                        HorizontalAlignment="Right" Margin="0,0,36,0">
                    <TextBlock Text="{Binding IsFavorite, Converter={StaticResource BoolToStar}}" FontSize="14"
                               Foreground="#FFC4B5FD"/>
                </Button>

                <!-- ✕ 삭제: 항상 보임 -->
                <Button Style="{StaticResource RowActionButtonStyle}"
                        Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding FullText}"
                        HorizontalAlignment="Right">
                    <TextBlock Text="✕" FontSize="12"/>
                </Button>
            </Grid>
        </DataTemplate>
    </local:AnchoredPanelWindowBase.Resources>

    <!-- 접근성/미관: 메인 키보드 창과 같은 둥근 카드로 그려 바깥 직각 레이어를 숨긴다. -->
    <Border Background="{DynamicResource KeyboardBg}"
            CornerRadius="{StaticResource KeyboardRadius}"
            ClipToBounds="True">
        <Grid Margin="10,8">
            <Grid.RowDefinitions>
                <!-- [헤더 균등] 스크래치패드의 헤더 행(30)과 동일 — 드래그 바 두께 인식이 달라 보였던 원인 -->
                <RowDefinition Height="30"/>
                <RowDefinition Height="34"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 헤더: 드래그 핸들(좌) | 전체 삭제 · ✕ (우) — 빠른 메모 창과 같은 구조, 제목 라벨은 없앰 -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- 드래그 핸들: 누르면 창 이동, 더블클릭은 화면 수평 중앙으로 (빠른 메모와 동일).
                     36×4 라운드 바 — 빠른 메모의 DragHandle과 치환 가능하게 같은 치수/색/투명도. -->
                <Border x:Name="DragHandle" Grid.Column="0" Background="Transparent" Cursor="SizeAll"
                        Margin="2,0" Padding="6,12"
                        MouseLeftButtonDown="DragHandle_MouseLeftButtonDown"
                        MouseMove="DragHandle_MouseMove"
                        MouseLeftButtonUp="DragHandle_MouseLeftButtonUp"
                        LostMouseCapture="DragHandle_LostMouseCapture">
                    <Rectangle Width="36" Height="4"
                               Fill="{DynamicResource SettingsFg}"
                               Opacity="0.45"
                               RadiusX="2" RadiusY="2"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"/>
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource HeaderButtonStyle}" Click="ClearHistory_Click"
                            ToolTip="히스토리 전체 삭제 (고정 항목은 보존)">
                        <TextBlock Text="전체 삭제" FontSize="11"/>
                    </Button>
                    <Button Style="{StaticResource HeaderButtonStyle}" Click="CloseButton_Click"
                            Focusable="True" AutomationProperties.Name="닫기">
                        <TextBlock Text="✕" FontSize="12"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 검색: 비어 있으면 placeholder, 텍스트가 있으면 ✕ 지우기 버튼 -->
            <Grid Grid.Row="1" Margin="0,4">
                <Border Background="{DynamicResource HeaderBarBg}" CornerRadius="6" BorderThickness="1"
                        BorderBrush="{DynamicResource HeaderBarBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- placeholder: 검색어가 비어 있을 때만 보임 -->
                        <TextBlock Grid.Column="0" Text="검색" FontSize="12" Opacity="0.5" IsHitTestVisible="False"
                                   Foreground="{DynamicResource SettingsFg}"
                                   VerticalAlignment="Center" Margin="10,0,0,0"
                                   Visibility="{Binding SearchText, Converter={StaticResource StringEmptyToVis}}"/>
                        <TextBox x:Name="SearchBox" Grid.Column="0"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0" FontSize="12"
                                 Foreground="{DynamicResource SettingsFg}" CaretBrush="#FFC4B5FD"
                                 VerticalAlignment="Center" Margin="8,0,0,0" Padding="0"/>
                        <!-- 지우기 버튼: 검색어가 있을 때만 보임 -->
                        <Button Grid.Column="1" Style="{StaticResource RowActionButtonStyle}" Width="26" Height="26"
                                Click="ClearSearch_Click"
                                Visibility="{Binding SearchText, Converter={StaticResource NonEmptyToVis}}">
                            <TextBlock Text="✕" FontSize="10"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- 목록: '고정' 섹션 + '최근' 리스트 (검색 필터는 ViewModel이 적용) -->
            <!-- [수평 폭 제약] 수평 스크롤바를 'Disabled'로 고정해야 한다. 'Hidden'으로 바꾸면 콘텐츠에
                 무한 폭을 줘서 긴 미리보기 행이 창 너비(360px)보다 넓게 늘어난다 — 별표·삭제 버튼까지
                 창 밖으로 밀려나고 TextTrimming ellipsis도 발동하지 않는다. 'Disabled'는 폭을 뷰포트에
                 맞춰 제약해 줄임이 정상 동작한다 (WPF 레이아웃 측정으로 확인). -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- 고정 섹션: 비어 있으면 숨김. ★ 항상 라벤더 채움 표시 -->
                    <ItemsControl ItemsSource="{Binding Favorites}" ItemTemplate="{StaticResource ClipboardItemRow}"
                                  Visibility="{Binding ShowFavoritesSection, Converter={StaticResource BoolToVis}}"/>

                    <!-- 최근: 단일 컬럼 최신순 -->
                    <ItemsControl ItemsSource="{Binding HistoryItems}" ItemTemplate="{StaticResource ClipboardItemRow}"/>

                    <!-- 빈 상태 안내: 검색 중이면 "맞는 항목이 없습니다", 아니면 시작 안내 (VM이 문구 결정) -->
                    <StackPanel Margin="0,24" HorizontalAlignment="Center" VerticalAlignment="Top"
                                Visibility="{Binding HasAnyItems, Converter={StaticResource InvBoolToVis}}">
                        <TextBlock Text="{Binding EmptyStateMessage}" FontSize="13" Opacity="0.6"
                                   Foreground="{DynamicResource SettingsFg}" HorizontalAlignment="Center"/>
                        <!-- 시작 안내는 검색이 아닐 때만 -->
                        <TextBlock Text="Ctrl+C로 복사를 시작하세요" FontSize="11" Opacity="0.45"
                                   Foreground="{DynamicResource SettingsFg}" HorizontalAlignment="Center" Margin="0,6,0,0"
                                   Visibility="{Binding IsSearching, Converter={StaticResource InvBoolToVis}}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</local:AnchoredPanelWindowBase>
